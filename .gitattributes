# Normalize line endings
* text=auto eol=lf

# Explicit text files
*.liquid     text eol=lf
*.js         text eol=lf
*.css        text eol=lf
*.scss       text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.svg        text eol=lf
*.html       text eol=lf

# Binary assets
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.avif       binary
*.ico        binary
*.woff       binary
*.woff2      binary
*.ttf        binary
*.otf        binary
*.eot        binary
*.mp4        binary
*.webm       binary
*.mov        binary
*.pdf        binary
