    "customer_reviews_shampoo": {
      "type": "seqes-testimonials",
      "blocks": {
        "review_1": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "text": "Mi hija tenía el cuero cabelludo muy reseco y con escamas. Desde que usamos Seqes, limpia super suave y ya no le queda irritado. Se nota que es diferente a los shampoos de farmacia.",
            "author": "Catalina G., mamá de Sofía (10 meses)",
            "verified": true
          }
        },
        "review_2": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "text": "No tiene olor a nada y eso me encanta. La mayoría de los shampoos de bebé tienen fragancias innecesarias. Este limpia bien, no irrita y el pelo queda suavecito. Muy contenta.",
            "author": "María José S., mamá de Benjamín (16 meses)",
            "verified": true
          }
        },
        "review_3": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "text": "Buscaba un shampoo sin sulfatos de verdad para mi bebé. Seqes cumple y además tiene activos anticaída. Lo uso también yo y noto la diferencia. Muy buena calidad.",
            "author": "Daniela V., mamá de Amanda (2 años)",
            "verified": true
          }
        },
        "review_4": {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "text": "La espuma es suave, no como otros que hacen un montón de espuma con sulfatos. Se nota que es un producto pensado de verdad para pieles sensibles. Lo recomiendo totalmente.",
            "author": "Constanza M., mamá de Lucas (7 meses)",
            "verified": true
          }
        }
      },
