{%- comment -%}
  robots.txt personalizado (patron oficial de Shopify: robots.default_groups).
  Repite las reglas por defecto de cada grupo y, para el grupo "*", agrega un
  grupo explicito por cada agente de IA y de busqueda que interesa a Seqes, con
  las mismas reglas de bloqueo (carrito, checkout, cuenta, busqueda, filtros).

  Todo se emite con `echo` dentro de un tag `liquid`, que no produce espacios
  propios: el unico salto de linea es la variable `nl`. Asi la salida no depende
  del control de espacios de la plantilla (con saltos escritos en la plantilla,
  Shopify devolvia una linea en blanco entre cada regla). No reformatear: el
  archivo esta excluido de prettier (.prettierignore).
{%- endcomment -%}
{%- capture nl %}
{% endcapture -%}
{%- liquid
  assign ai_agents = 'GPTBot,OAI-SearchBot,ChatGPT-User,ClaudeBot,Claude-Web,anthropic-ai,PerplexityBot,Perplexity-User,Google-Extended,Applebot-Extended,CCBot' | split: ','
  for group in robots.default_groups
    echo group.user_agent | strip_newlines
    echo nl
    for rule in group.rules
      echo rule | strip_newlines
      echo nl
    endfor
    if group.sitemap != blank
      echo group.sitemap | strip_newlines
      echo nl
    endif
    if group.user_agent.value == '*'
      for agent in ai_agents
        echo nl
        echo group.user_agent | strip_newlines | replace: '*', agent
        echo nl
        for rule in group.rules
          echo rule | strip_newlines
          echo nl
        endfor
      endfor
    endif
    echo nl
  endfor
-%}
