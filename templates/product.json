{
  "sections": {
    "breadcrumbs": {
      "type": "breadcrumbs",
      "settings": {}
    },
    "main-product": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "style_vendor"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "uppercase": false,
            "show_products_rating": true,
            "show_custom_badges": true
          }
        },
        "description": {
          "type": "description",
          "settings": {
            "seo_text_max_height": 400,
            "seo_text_read_more": "Leer más",
            "seo_text_read_less": "Leer menos"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "color_picker": true,
            "color_picker_size": "regular",
            "color_picker_use_variants": false,
            "variant_is_disabled": true,
            "sizing_guide_variant": "Size",
            "sizing_guide_text": "",
            "sizing_guide_icon": "none",
            "sizing_guide_page": ""
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity_selector": true,
            "outline_button": true,
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "collapsible_ingredientes": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Ingredientes",
            "open": false,
            "content": "",
            "page": "",
            "custom_liquid": "{{ product.metafields.custom.ingredientes | metafield_tag }}"
          }
        },
        "collapsible_modo_de_uso": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Modo de Uso",
            "open": false,
            "content": "",
            "page": "",
            "custom_liquid": "{{ product.metafields.custom.modo_de_uso | metafield_tag }}"
          }
        },
        "collapsible_advertencias": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Advertencias",
            "open": false,
            "content": "",
            "page": "",
            "custom_liquid": "{{ product.metafields.custom.advertencias | metafield_tag }}"
          }
        },
        "side_panel": {
          "type": "side_panel",
          "settings": {
            "side_panel_1_label": "Ingredientes",
            "side_panel_1_icon": "check_mark",
            "side_panel_1_content": "<p>{{ product.metafields.custom.ingredientes | metafield_tag }}</p>",
            "side_panel_1_page": "",
            "side_panel_2_label": "Modo de Uso",
            "side_panel_2_icon": "question_mark",
            "side_panel_2_content": "<p>{{ product.metafields.custom.modo_de_uso | metafield_tag }}</p>",
            "side_panel_2_page": "",
            "side_panel_3_label": "Advertencias",
            "side_panel_3_icon": "return",
            "side_panel_3_content": "<p>{{ product.metafields.custom.advertencias | metafield_tag }}</p>",
            "side_panel_3_page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {}
        }
      },
      "block_order": [
        "vendor",
        "title",
        "description",
        "variant_picker",
        "buy_buttons",
        "collapsible_ingredientes",
        "collapsible_modo_de_uso",
        "collapsible_advertencias",
        "side_panel",
        "share"
      ],
      "settings": {
        "full_width": true,
        "enable_sticky_info": true,
        "enable_sticky_add_to_cart": true,
        "show_taxes_included": true,
        "media_layout": "thumbnails",
        "display_slider_pagination": true,
        "media_aspect_ratio": "adapt",
        "display_captions": true,
        "hide_variants": false,
        "lightbox": true,
        "enable_video_looping": false
      }
    },
    "product-recommendations": {
      "type": "product-recommendations",
      "settings": {
        "heading": "También te puede interesar",
        "heading_left": true,
        "description": "",
        "full_width": true,
        "mobile_swipe": true,
        "disable_top_spacing": false,
        "disable_bottom_spacing": false
      }
    }
  },
  "order": [
    "breadcrumbs",
    "main-product",
    "product-recommendations"
  ]
}