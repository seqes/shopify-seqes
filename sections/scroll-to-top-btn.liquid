{%- if section.settings.enable_scroll_btn -%}
{%- style -%}
  .scroll-to-top-btn {
    position: fixed;
    z-index: 999;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,.2);
    transition: opacity .3s ease, transform .3s ease;
    background: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_icon_color }};
  }
  .scroll-to-top-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0,0,0,.3);
  }
  .scroll-to-top-btn svg {
    width: 18px;
    height: 18px;
  }
  .scroll-to-top-btn--bottom-left {
    bottom: var(--stt-offset-y);
    left: var(--stt-offset-x);
  }
  .scroll-to-top-btn--bottom-center {
    bottom: var(--stt-offset-y);
    left: 50%;
    transform: translateX(-50%);
  }
  .scroll-to-top-btn--bottom-center:hover {
    transform: translateX(-50%) translateY(-2px);
  }
  .scroll-to-top-btn--bottom-right {
    bottom: var(--stt-offset-y);
    right: var(--stt-offset-x);
  }
  .scroll-to-top-btn-{{ section.id }} {
    --stt-offset-x: {{ section.settings.offset_x | times: 0.75 | divided_by: 10.0 }}rem;
    --stt-offset-y: {{ section.settings.offset_y | times: 0.75 | divided_by: 10.0 }}rem;
  }
  @media screen and (min-width: 750px) {
    .scroll-to-top-btn-{{ section.id }} {
      --stt-offset-x: {{ section.settings.offset_x | divided_by: 10.0 }}rem;
      --stt-offset-y: {{ section.settings.offset_y | divided_by: 10.0 }}rem;
    }
  }
{%- endstyle -%}

<button
  class="scroll-to-top-btn scroll-to-top-btn--{{ section.settings.position }} scroll-to-top-btn-{{ section.id }}"
  aria-label="Scroll to top"
  data-scroll-threshold="{{ section.settings.display_after }}"
  {% unless section.settings.display_after == 0 %}style="display:none"{% endunless %}
>
  <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
    <path fill="currentColor" d="M233.4 105.4c12.5-12.5 32.8-12.5 45.3 0l192 192c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L256 173.3 86.6 342.6c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3l192-192z"/>
  </svg>
</button>

<script>
  (function(){
    var btn = document.querySelector('.scroll-to-top-btn-{{ section.id }}');
    if (!btn) return;
    var threshold = parseInt(btn.dataset.scrollThreshold, 10);
    if (threshold > 0) {
      var onScroll = function() {
        btn.style.display = window.scrollY > threshold ? '' : 'none';
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
    btn.addEventListener('click', function() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Scroll to Top Button",
  "limit": 1,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_scroll_btn",
      "default": false,
      "label": "Enable scroll to top button"
    },
    {
      "type": "range",
      "id": "display_after",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Display after scrolling",
      "default": 400
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_icon_color",
      "label": "Button icon color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "position",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-right",
      "label": "Position"
    },
    {
      "type": "range",
      "id": "offset_x",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Offset X",
      "default": 20,
      "info": "Not applied when centered"
    },
    {
      "type": "range",
      "id": "offset_y",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Offset Y",
      "default": 20
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
