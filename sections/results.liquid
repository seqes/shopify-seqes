        {"type":"range","id":"percentage","min": 0,"max": 100,"default": 90,"step": 1,"label":"Percentage"
        },
        {"type":"richtext","id":"row_text","default":"<p>Noticed that this product has significantly improved their life.</p>","label":"Result"
        }
      ]
    }
  ],"presets": [
    {"name":"Results","blocks": [
        {"type":"row"
        },
        {"type":"row"
        },
        {"type":"row"
        }
      ]
    }
  ],"disabled_on": {"groups": ["header","footer"
    ]
  }
}
{% endschema %}
