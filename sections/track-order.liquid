{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Base layout rules */
  .track-order-form {padding-bottom: 2rem;margin: 0 auto;max-width: 60rem;}
  .track-order-form .field {margin-top: 3rem;}

  .section-color-{{ section.id }}-color_scheme { background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; }
{%- endstyle -%}

<div class="section-color-{{ section.id }}-color_scheme gradient {{ section.settings.visibility }}">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="track-order-form">
      <div class="center">
        {%- if section.settings.heading != blank -%}
          <h2 class="title title-wrapper--no-top-margin {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {% if section.settings.text != blank %}
          {{ section.settings.text }}
        {% endif %}
      </div>
      <div class="field">
        <input
          type="text"
          id="YQNum"
          class="field__input"
          name="track-order-number"
          maxlength="50"
          placeholder="Tracking Number"
        >
        <label class="field__label" for="track-order-number">Tracking Number</label>
      </div>
      <div class="contact__button">
        <button
          type="button"
          id="YQTrackBtn-{{ section.id }}"
          class="button{% if section.settings.button_full_width %} button--full-width{% endif %}"
        >{{ section.settings.button_label }}</button>
      </div>
      <div id="YQError-{{ section.id }}" class="track-order-error" role="alert" aria-live="polite" style="color:rgb(var(--color-error,224,53,53));margin-top:1rem;min-height:1em;"></div>
    </div>
    <div id="YQContainer"></div>
  </div>
</div>

<script>
  (function () {
    var btn = document.getElementById('YQTrackBtn-{{ section.id }}');
    var input = document.getElementById('YQNum');
    var errorEl = document.getElementById('YQError-{{ section.id }}');
    if (!btn || !input) return;

    var scriptPromise = null;
    function ensureScript() {
      if (scriptPromise) return scriptPromise;
      scriptPromise = new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = 'https://www.17track.net/externalcall.js';
        s.async = true;
        s.onload = resolve;
        s.onerror = reject;
        document.body.appendChild(s);
      });
      return scriptPromise;
    }

    // Warm the script on first interaction with the input so the click
    // feels instant, but do not load it on every page view.
    input.addEventListener('focus', ensureScript, { once: true });

    btn.addEventListener('click', function () {
      errorEl.textContent = '';
      var num = input.value.trim();
      if (!num) {
        errorEl.textContent = 'Enter your number.';
        input.focus();
        return;
      }
      ensureScript().then(function () {
        if (typeof YQV5 === 'undefined') {
          errorEl.textContent = 'Tracking service is unavailable. Please try again later.';
          return;
        }
        YQV5.trackSingle({
          YQ_ContainerId: 'YQContainer',
          YQ_Height: 560,
          YQ_Fc: '0',
          YQ_Lang: '{{ request.locale.iso_code | default: "en" }}',
          YQ_Num: num
        });
      }).catch(function () {
        errorEl.textContent = 'Tracking service failed to load.';
      });
    });
  })();
</script>

{% schema %}
{"name":"Track order","disabled_on": {"groups": ["header","footer"
    ]
  },"settings": [
    {"type":"select","id":"visibility","options": [
        {"value":"desktop-hidden","label":"Mobile only"
        },
        {"value":"mobile-hidden","label":"Desktop only"
        },
        {"value":"always-display","label":"All devices"
        }
      ],"label":"Display on","default":"always-display"
    },
    {"type":"text","id":"heading","default":"Track Order","label":"Heading"
    },
    {"type":"richtext","id":"text","label":"Text","default":"<p>Please enter you tracking number below. if your tracking number doesn't work feel free to contact us at [shop email]</p>"
    },
    {"type":"select","id":"heading_size","options": [
        {"value":"h2","label":"Small"
        },
        {"value":"h1","label":"Medium"
        },
        {"value":"h0","label":"Large"
        }
      ],"default":"h2","label":"Heading size"
    },
    {"type":"text","id":"button_label","label":"Button label","default":"TRACK"
    },
    {"type":"checkbox","id":"button_full_width","label":"Use full width button style","default": true
    },
    {"type":"color","id":"bg_color","label":"Background color","default":"#ffffff"
    },
    {"type":"color","id":"text_color","label":"Text color","default":"#121212"
    },
    {"type":"header","content":"Section padding"
    },
    {"type":"range","id":"padding_top","min": 0,"max": 100,"step": 4,"unit":"px","label":"Padding top","default": 36
    },
    {"type":"range","id":"padding_bottom","min": 0,"max": 100,"step": 4,"unit":"px","label":"Padding bottom","default": 36
    }
  ],"presets": [
    {"name":"Track order"
    }
  ]
}
{% endschema %}
