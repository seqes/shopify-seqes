{%- liquid
  assign desktop_height = section.settings.desktop_height
  assign mobile_height = section.settings.mobile_height
  assign full_width = section.settings.full_width
  assign fallback_image = section.settings.fallback_image
  assign overlay_opacity = section.settings.overlay_opacity
  assign video = section.settings.video
  assign video_hosted = section.settings.video_hosted
  assign subheading = section.settings.subheading
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign lightbox_button = section.settings.lightbox_button
  assign disable_top_spacing = section.settings.disable_top_spacing
  assign disable_bottom_spacing = section.settings.disable_bottom_spacing
  assign use_fallback_image = section.settings.use_fallback_image
  assign frame_desktop = section.settings.frame_desktop
  assign frame_mobile = section.settings.frame_mobile
  comment
    Cada marco se muestra solo en su pantalla: un PNG pensado para una proporcion se ve mal en la otra.
  endcomment
  assign frame_desktop_on = false
  assign frame_mobile_on = false
  if section.settings.show_frame
    if frame_desktop != blank
      assign frame_desktop_on = true
    endif
    if frame_mobile != blank
      assign frame_mobile_on = true
    endif
  endif
-%}
<div class="row {% if full_width %}full-width-row-full{% endif %}">
  <div class="small-12 columns">
    <background-video
      class="background-video {{ mobile_height }} {{ desktop_height }} section-spacing{% if disable_top_spacing %} section-spacing--disable-top{% endif %}{% if disable_bottom_spacing %} section-spacing--disable-bottom{% endif %}{% if frame_mobile_on %} background-video--frame-mobile{% endif %}"
      {% if frame_mobile_on %}
        style="--frame-mobile-text-offset: {{ section.settings.frame_mobile_text_offset }}px;"
      {% endif %}
    >
      {%- if fallback_image != blank -%}
        <div class="background-video__fallback-img">
          {%- if section.index == 1 -%}
            <img
              src="{{ fallback_image | image_url }}"
              alt="{{ fallback_image.alt | escape }}"
              width="{{ fallback_image.width }}"
              height="{{ fallback_image.height }}"
              loading="eager"
              fetchpriority="high"
              class="no-blur"
            />
          {%- else -%}
            <img
              data-src="{{ fallback_image | image_url }}"
              alt="{{ fallback_image.alt | escape }}"
              width="{{ fallback_image.width }}"
              height="{{ fallback_image.height }}"
              class="lazyload{% unless settings.lazy_loading %} no-blur{% endunless %}"
            />
            <noscript>
              <img
                src="{{ fallback_image | image_url }}"
                alt="{{ fallback_image.alt | escape }}"
                width="{{ fallback_image.width }}"
                height="{{ fallback_image.height }}"
              />
            </noscript>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- unless use_fallback_image and fallback_image != blank -%}
        <div class="background-video__iframe" data-provider="{{ video.type }}">
          {%- if video_hosted == blank -%}
            {%- if video != blank -%}
              {%- if video.type == 'youtube' -%}
                <iframe
                  data-src="https://www.youtube.com/embed/{{ video.id }}?loop=1&autoplay=1&mute=1&playlist={{ video.id }}&iv_load_policy=3&disablekb=1&controls=0&playsinline=1&enablejsapi=1"
                  frameborder="0"
                  class="lazyload"
                  allow="autoplay; encrypted-media"
                  allowfullscreen
                  title="{{ section.settings.heading | escape }}"
                  tabindex="-1"
                ></iframe>
              {%- else -%}
                <iframe
                  data-src="https://player.vimeo.com/video/{{ video.id }}?background=1"
                  frameborder="0"
                  class="lazyload"
                  allow="autoplay; encrypted-media"
                  allowfullscreen
                  title="{{ section.settings.heading | escape }}"
                  tabindex="-1"
                ></iframe>
              {%- endif -%}
            {%- endif -%}
          {%- else -%}
            {{ video_hosted | video_tag: autoplay: true, loop: true, controls: false, muted: true }}
          {%- endif -%}
        </div>
      {%- endunless -%}
      <div
        class="background-video__overlay"
        style="--overlay-opacity: {{ overlay_opacity | divided_by: 100.00 }}"
      ></div>
      {%- if frame_desktop_on or frame_mobile_on -%}
        {%- comment -%}
          Marco inferior: PNG transparente (silueta, ola, etc.) sobre el video y el oscurecido, bajo el texto.
          Se ancla abajo y cubre la seccion. Carga nativa (no lazysizes): es decorativo y sin efecto de desenfoque.
        {%- endcomment -%}
        <picture class="background-video__frame{% unless frame_desktop_on %} background-video__frame--mobile-only{% endunless %}{% unless frame_mobile_on %} background-video__frame--desktop-only{% endunless %}">
          {%- comment -%}
            Con un solo marco, la otra pantalla recibe un GIF vacio de 1x1: una imagen eager oculta con
            display:none igual se descargaria.
          {%- endcomment -%}
          {%- assign frame_empty = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7' -%}
          {%- if frame_desktop_on and frame_mobile_on -%}
            <source
              media="(max-width: 767px)"
              srcset="{{ frame_mobile | image_url: width: 750 }} 750w, {{ frame_mobile | image_url: width: 1125 }} 1125w"
              sizes="100vw"
            >
          {%- elsif frame_desktop_on -%}
            <source media="(max-width: 767px)" srcset="{{ frame_empty }}">
          {%- else -%}
            <source media="(min-width: 768px)" srcset="{{ frame_empty }}">
          {%- endif -%}
          {%- if frame_desktop_on -%}
            {%- assign frame_img = frame_desktop -%}
            {%- assign frame_src_w = 1440 -%}
            {%- capture frame_srcset -%}{{ frame_desktop | image_url: width: 1440 }} 1440w, {{ frame_desktop | image_url: width: 1920 }} 1920w, {{ frame_desktop | image_url: width: 2880 }} 2880w{%- endcapture -%}
          {%- else -%}
            {%- assign frame_img = frame_mobile -%}
            {%- assign frame_src_w = 750 -%}
            {%- capture frame_srcset -%}{{ frame_mobile | image_url: width: 750 }} 750w, {{ frame_mobile | image_url: width: 1125 }} 1125w{%- endcapture -%}
          {%- endif -%}
          <img
            src="{{ frame_img | image_url: width: frame_src_w }}"
            srcset="{{ frame_srcset }}"
            sizes="100vw"
            alt=""
            width="{{ frame_img.width }}"
            height="{{ frame_img.height }}"
            {% if section.index == 1 %}
              loading="eager"
            {% else %}
              loading="lazy"
            {% endif %}
            decoding="async"
            class="no-blur"
          >
        </picture>
      {%- endif -%}
      <div class="background-video__content-wrap">
        <div class="background-video__content">
          {%- if subheading != blank -%}
            <p class="subheading">{{ subheading }}</p>
          {%- endif -%}
          {%- if heading != blank -%}
            {%- liquid
              if section.index == 1
                assign heading_tag = 'h1'
              else
                assign heading_tag = 'h3'
              endif
            -%}
            <{{ heading_tag }} class="h1">{{ heading | newline_to_br }}</{{ heading_tag }}>
          {%- endif -%}
          {%- if text != blank -%}
            <p>{{ text }}</p>
          {%- endif -%}
          {%- if lightbox_button -%}
            <modal-opener
              class="video-lightbox-modal__opener no-js-hidden"
              data-modal="#VideoLightbox-{{ section.id }}"
            >
              <button
                id="VideoLightboxToggle-{{ section.id }}"
                class="video-lightbox-modal__button"
                type="button"
                aria-haspopup="dialog"
              >
                {% render 'svg-icons' with 'thb-video-play' %}
              </button>
            </modal-opener>
            <a href="{{ video.url }}" class="video-lightbox-modal__button no-js" target="_blank">
              {%- render 'svg-icons' with 'thb-video-play' -%}
            </a>
            <modal-dialog id="VideoLightbox-{{ section.id }}" class="video-lightbox-modal">
              <div
                role="dialog"
                aria-label="{{ heading }}"
                aria-modal="true"
                class="video-lightbox-modal__content"
                tabindex="-1"
              >
                <button
                  id="ModalClose-{{ section.id }}"
                  type="button"
                  class="video-lightbox-modal__toggle"
                  aria-label="{{ 'accessibility.close' | t }}"
                >
                  {% render 'svg-icons' with 'close' %}
                </button>
                <div class="video-lightbox-modal__content-info">
                  {%- if video_hosted == blank -%}
                    {%- if video.type == 'youtube' -%}
                      <iframe
                        data-src="https://www.youtube.com/embed/{{ video.id }}?enablejsapi=1"
                        class="js-youtube lazyload"
                        allow="autoplay; encrypted-media"
                        allowfullscreen
                      ></iframe>
                    {%- else -%}
                      <iframe
                        data-src="https://player.vimeo.com/video/{{ video.id }}"
                        class="js-vimeo lazyload"
                        allow="autoplay; encrypted-media"
                        allowfullscreen
                      ></iframe>
                    {%- endif -%}
                  {%- else -%}
                    {{ video_hosted | video_tag: autoplay: false, loop: false, controls: true }}
                  {%- endif -%}
                </div>
              </div>
            </modal-dialog>
            <script src="{{ 'modal-dialog.js' | asset_url }}" defer="defer"></script>
          {%- endif -%}
        </div>
      </div>
    </background-video>
  </div>
</div>
{{- 'background-video.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'background-video.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "Background video",
  "class": "section-background-video",
  "settings": [
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop height",
      "options": [
        {
          "value": "desktop-height-auto",
          "label": "Adapt to content"
        },
        {
          "value": "desktop-height-450",
          "label": "450px"
        },
        {
          "value": "desktop-height-550",
          "label": "550px"
        },
        {
          "value": "desktop-height-650",
          "label": "650px"
        },
        {
          "value": "desktop-height-750",
          "label": "750px"
        },
        {
          "value": "desktop-height-full",
          "label": "Full screen"
        }
      ],
      "default": "desktop-height-650"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile height",
      "options": [
        {
          "value": "mobile-height-auto",
          "label": "Adapt to content"
        },
        {
          "value": "mobile-height-350",
          "label": "350px"
        },
        {
          "value": "mobile-height-400",
          "label": "400px"
        },
        {
          "value": "mobile-height-450",
          "label": "450px"
        },
        {
          "value": "mobile-height-500",
          "label": "500px"
        },
        {
          "value": "mobile-height-full",
          "label": "Full screen"
        }
      ],
      "default": "mobile-height-500"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": true
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Add a tagline"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Background video heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review."
    },
    {
      "type": "checkbox",
      "id": "lightbox_button",
      "label": "Display lightbox play button",
      "default": true
    },
    {
      "type": "video_url",
      "id": "video",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"],
      "placeholder": "Use a YouTube or Vimeo URL",
      "default": "https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc",
      "info": "Video plays in a lightbox."
    },
    {
      "type": "video",
      "id": "video_hosted",
      "label": "Shopify-hosted video",
      "info": "Overrides the Video URL setting."
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Fallback image",
      "info": "1920 x 1080 px .jpg recommended."
    },
    {
      "type": "checkbox",
      "id": "use_fallback_image",
      "label": "Usar la foto de fondo en vez del video",
      "info": "Muestra la Fallback image y oculta el video sin borrarlo (útil para una promoción). Requiere cargar la Fallback image; sin ella se sigue mostrando el video. El botón de play (lightbox) sigue activo si está encendido.",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 25
    },
    {
      "type": "header",
      "content": "Marco inferior (silueta)"
    },
    {
      "type": "paragraph",
      "content": "PNG transparente sobre el video, anclado abajo; cada marco se ve solo en su pantalla. Medidas: escritorio 2880 x 1100 px (alto 550 px) y celular 750 x 1000 px (alto 500 px), con alto fijo, no \"Adapt to content\". En escritorio, figuras a los lados o abajo. Menos de 300 KB. Para fundir la ola con la sección siguiente, usar su color y activar \"Remove bottom spacing\"."
    },
    {
      "type": "checkbox",
      "id": "show_frame",
      "label": "Mostrar marco",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "frame_desktop",
      "label": "Marco escritorio"
    },
    {
      "type": "image_picker",
      "id": "frame_mobile",
      "label": "Marco celular",
      "info": "Si se deja vacío, el celular va sin marco."
    },
    {
      "type": "range",
      "id": "frame_mobile_text_offset",
      "min": 20,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Celular: distancia del texto al borde superior",
      "info": "Con marco, en celular el texto se ancla arriba para no taparse con las siluetas.",
      "default": 50
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "disable_top_spacing",
      "default": false,
      "label": "Remove top spacing"
    },
    {
      "type": "checkbox",
      "id": "disable_bottom_spacing",
      "default": false,
      "label": "Remove bottom spacing"
    }
  ],
  "presets": [
    {
      "name": "Background video"
    }
  ],
  "enabled_on": {
    "templates": ["*"],
    "groups": ["header", "footer"]
  }
}
{% endschema %}
