{%- style -%}
  .iwc-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  .iwc__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    align-items: center;
  }
  .iwc__icons {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .iwc__icons--2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .iwc__icon-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .iwc__icon-item--above {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .iwc__icon-item--next-to-title {
    flex-direction: row;
    align-items: flex-start;
  }
  .iwc__icon-item--next-to-text {
    flex-direction: row;
    align-items: flex-start;
  }
  .iwc__icon-img {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .iwc__icon-img--s { font-size: 20px; }
  .iwc__icon-img--s img { height: 20px; width: auto; }
  .iwc__icon-img--m { font-size: 28px; }
  .iwc__icon-img--m img { height: 28px; width: auto; }
  .iwc__icon-img--l { font-size: 40px; }
  .iwc__icon-img--l img { height: 40px; width: auto; }
  .iwc__icon-img--xl { font-size: 56px; }
  .iwc__icon-img--xl img { height: 56px; width: auto; }
  .iwc__icon-text h3 { margin: 0 0 4px; }
  .iwc__icon-text .rte { margin: 0; opacity: 0.85; }
  .iwc__content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .iwc__content h2 { margin: 0; }
  .iwc__content .rte { margin: 0; }
  .iwc__content .button {
    display: inline-block;
    padding: 10px 24px;
    border: 1px solid currentColor;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: opacity .2s;
  }
  .iwc__content .button:hover { opacity: 0.7; }
  .iwc__content-img img {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  @media screen and (min-width: 750px) {
    .iwc-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .iwc__grid {
      grid-template-columns: 1fr 1fr;
    }
    .iwc__grid--content-first .iwc__content { order: -1; }
  }
  .iwc__grid--mobile-content-first .iwc__content { order: -1; }
  @media screen and (min-width: 750px) {
    .iwc__grid--mobile-content-first .iwc__content { order: unset; }
  }
  .iwc__content--hide-mobile {
    display: none;
  }
  @media screen and (min-width: 750px) {
    .iwc__content--hide-mobile { display: flex; }
  }
{%- endstyle -%}

<div class="iwc-{{ section.id }} {{ section.settings.visibility }}">
  <div class="iwc__grid{% if section.settings.layout == 'text_first' %} iwc__grid--content-first{% endif %}{% if section.settings.mobile_layout == 'text_first' %} iwc__grid--mobile-content-first{% endif %}">

    <div class="iwc__icons{% if section.settings.icons_layout == '2-columns' %} iwc__icons--2col{% endif %}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'icon' -%}
          <div class="iwc__icon-item iwc__icon-item--{{ section.settings.icon_position }}" {{ block.shopify_attributes }}>
            {%- if section.settings.icon_position != 'next-to-title' -%}
              <div class="iwc__icon-img iwc__icon-img--{{ section.settings.icon_size }}" style="color:{{ section.settings.icon_color }}">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 300 }}" {% if block.settings.image.alt != blank %}alt="{{ block.settings.image.alt | escape }}"{% else %}role="presentation"{% endif %} loading="lazy">
                {%- elsif block.settings.icon != blank -%}
                  {%- render 'material-icon', icon: block.settings.icon, filled: block.settings.filled_icon -%}
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="iwc__icon-text">
              {%- if block.settings.title != blank -%}
                <h3 style="display:flex;align-items:center;gap:6px">
                  {%- if section.settings.icon_position == 'next-to-title' -%}
                    <span class="iwc__icon-img iwc__icon-img--{{ section.settings.icon_size }}" style="color:{{ section.settings.icon_color }}">
                      {%- if block.settings.image != blank -%}
                        <img src="{{ block.settings.image | image_url: width: 300 }}" {% if block.settings.image.alt != blank %}alt="{{ block.settings.image.alt | escape }}"{% else %}role="presentation"{% endif %} loading="lazy">
                      {%- elsif block.settings.icon != blank -%}
                        {%- render 'material-icon', icon: block.settings.icon, filled: block.settings.filled_icon -%}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                  <span>{{ block.settings.title | escape }}</span>
                </h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="iwc__content{% if section.settings.hide_content_on_mobile %} iwc__content--hide-mobile{% endif %}" style="text-align:{{ section.settings.content_alignment }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="{{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h2>
          {%- when 'caption' -%}
            <p style="text-transform:uppercase;letter-spacing:0.1em;font-size:0.85em;opacity:0.7" {{ block.shopify_attributes }}>
              {{ block.settings.caption | escape }}
            </p>
          {%- when 'text' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            {%- if block.settings.button_label != blank -%}
              <div>
                <a
                  {% if block.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %}
                  class="button"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.button_label | escape }}
                </a>
              </div>
            {%- endif -%}
          {%- when 'image' -%}
            <div class="iwc__content-img" {{ block.shopify_attributes }}>
              {{ block.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '360, 535, 750, 1070, 1500' }}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Icons with content",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "options": [
        { "value": "desktop-hidden", "label": "Mobile only" },
        { "value": "mobile-hidden", "label": "Desktop only" },
        { "value": "always-display", "label": "All devices" }
      ],
      "label": "Display on",
      "default": "always-display"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "select",
      "id": "icon_size",
      "options": [
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ],
      "default": "m",
      "label": "Icon size"
    },
    {
      "type": "select",
      "id": "icon_position",
      "options": [
        { "value": "above", "label": "Above title & text" },
        { "value": "next-to-title", "label": "Next to title" },
        { "value": "next-to-text", "label": "Next to text & title" }
      ],
      "label": "Icon position",
      "default": "next-to-title"
    },
    {
      "type": "select",
      "id": "icons_layout",
      "options": [
        { "value": "1-column", "label": "1 column" },
        { "value": "2-columns", "label": "2 columns" }
      ],
      "default": "1-column",
      "label": "Icons layout"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Content alignment"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "text_first", "label": "Content first" },
        { "value": "image_first", "label": "Content second" }
      ],
      "default": "image_first",
      "label": "Desktop content placement"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "options": [
        { "value": "text_first", "label": "Content first" },
        { "value": "image_first", "label": "Content second" }
      ],
      "default": "text_first",
      "label": "Mobile content placement"
    },
    {
      "type": "checkbox",
      "id": "hide_content_on_mobile",
      "label": "Hide content on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon with text",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "default": "check_circle",
          "label": "Material icon name",
          "info": "[View all available icons](https://fonts.google.com/icons?icon.set=Material+Symbols&icon.platform=web)"
        },
        {
          "type": "checkbox",
          "id": "filled_icon",
          "default": false,
          "label": "Filled icon"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon (overrides material icon)"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Feature",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Describe this feature with a brief explanation</p>",
          "label": "Text"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Content heading",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h3", "label": "Small" },
            { "value": "h2", "label": "Medium" },
            { "value": "h1", "label": "Large" }
          ],
          "default": "h2",
          "label": "Heading size"
        }
      ]
    },
    {
      "type": "caption",
      "name": "Caption",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "default": "Add a tagline",
          "label": "Caption"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Pair icons with content to highlight features</p>",
          "label": "Text"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icons with content",
      "blocks": [
        { "type": "icon" },
        { "type": "icon" },
        { "type": "icon" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
