{% schema %}
{
  "name": "Instagram stories",
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "options": [
        { "value": "desktop-hidden", "label": "Mobile only" },
        { "value": "mobile-hidden", "label": "Desktop only" },
        { "value": "always-display", "label": "All devices" }
      ],
      "label": "Display on",
      "default": "always-display"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Instagram stories",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Display images and testimonials in a format familiar to your customers.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "info": "Overrides the heading color independently. Leave empty to inherit from Text color."
    },
    {
      "type": "header",
      "content": "Tamaño de burbujas"
    },
    {
      "type": "range",
      "id": "bubble_size_desktop",
      "min": 4,
      "max": 12,
      "step": 0.5,
      "unit": "rem",
      "label": "Tamaño en desktop",
      "default": 7
    },
    {
      "type": "range",
      "id": "bubble_size_mobile",
      "min": 4,
      "max": 12,
      "step": 0.5,
      "unit": "rem",
      "label": "Tamaño en móvil",
      "default": 6
    },
    {
      "type": "header",
      "content": "Stories"
    },
    {
      "type": "paragraph",
      "content": "On touch devices, swipe gestures are enabled for the best mobile experience."
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 5,
      "max": 15,
      "step": 1,
      "unit": "sec",
      "label": "Image autoplay speed",
      "default": 10
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "user",
      "name": "User post",
      "settings": [
        {
          "type": "text",
          "id": "username",
          "label": "User name",
          "default": "username"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified account",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "profile_picture",
          "label": "Profile picture"
        },
        {
          "type": "checkbox",
          "id": "close_friends",
          "label": "Close friends story (green ring)",
          "default": false
        },
        {
          "type": "header",
          "content": "Story #1"
        },
        {
          "type": "image_picker",
          "id": "story_1_image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "story_1_video",
          "label": "Video (overrides image)"
        },
        {
          "type": "select",
          "id": "story_1_media_fit",
          "options": [
            { "value": "contain", "label": "Contain" },
            { "value": "cover", "label": "Cover" }
          ],
          "default": "contain",
          "label": "Media fit"
        },
        {
          "type": "text",
          "id": "story_1_time_posted",
          "label": "Time posted",
          "default": "10m"
        },
        {
          "type": "color",
