            { "value": "cover", "label": "Cover" }
          ],
          "default": "contain",
          "label": "Media fit"
        },
        {
          "type": "text",
          "id": "story_2_time_posted",
          "label": "Time posted",
          "default": "1h"
        },
        {
          "type": "color",
          "id": "story_2_bg",
          "label": "Background",
          "default": "#282828"
        },
        {
          "type": "header",
          "content": "Story #3"
        },
        {
          "type": "image_picker",
          "id": "story_3_image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "story_3_video",
          "label": "Video (overrides image)"
        },
        {
          "type": "select",
          "id": "story_3_media_fit",
          "options": [
            { "value": "contain", "label": "Contain" },
            { "value": "cover", "label": "Cover" }
          ],
          "default": "contain",
          "label": "Media fit"
        },
        {
          "type": "text",
          "id": "story_3_time_posted",
          "label": "Time posted",
          "default": "4h"
        },
        {
          "type": "color",
          "id": "story_3_bg",
          "label": "Background",
          "default": "#282828"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram stories",
      "blocks": [
        { "type": "user" },
        { "type": "user" },
        { "type": "user" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
