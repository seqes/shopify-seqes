{{ 'breadcrumbs.css' | asset_url | stylesheet_tag }}
<nav class="breadcrumbs" aria-label="breadcrumbs">
  <a href="{{ routes.root_url }}">{{ 'sections.breadcrumbs.home' | t }}</a>

  {%- if template contains 'product' -%}
    {%- if product.template_suffix == 'crema-corporal-bebe' -%}
      <i>/</i>
      <a href="/collections/bebe" title="Bebé">Bebé</a>
      <i>/</i>
      <a href="/collections/crema-corporal" title="Crema Corporal">Crema Corporal</a>
    {%- elsif product.template_suffix == 'shampoo-bebe' -%}
      <i>/</i>
      <a href="/collections/bebe" title="Bebé">Bebé</a>
      <i>/</i>
      <a href="/collections/jabon-y-champu" title="Jabón y Champú">Jabón y Champú</a>
    {%- elsif collection.url -%}
      <i>/</i>
      <a href="{{ routes.all_products_collection_url }}">{{ 'sections.breadcrumbs.shop' | t }}</a>
      <i>/</i>
      {{ collection.title }}
    {%- endif -%}
    <i>/</i>
    {{ product.title }}
  {%- elsif collection.url -%}
    <i>/</i>
    <a href="{{ routes.all_products_collection_url }}">{{ 'sections.breadcrumbs.shop' | t }}</a>
    <i>/</i>
    {{ collection.title }}
  {%- endif -%}

  {% if template contains 'cart' %}
    <i>/</i>
    {{ 'sections.breadcrumbs.cart' | t }}
  {% endif %}
  {% if template contains 'blog' %}
    {% if current_tags %}
      <i>/</i>
      <a href="{{ blog.url }}">{{ blog.title }}</a>
      <i>/</i>
      {{ current_tags }}
    {% else %}
      <i>/</i>
      {{ blog.title }}
    {% endif %}
  {% endif %}
  {% if template contains 'article' %}
    <i>/</i>
    <a href="{{ blog.url }}" title="{{ blog.title | escape }}">{{ blog.title }}</a>
    <i>/</i>
    {{ article.title }}
  {% endif %}
  {% if template contains 'page' %}
    <i>/</i>
    {{ page.title }}
  {% endif %}
  {% if template contains 'search' %}
    <i>/</i>
    {{ 'sections.breadcrumbs.search' | t }}
  {% endif %}
  {% if template contains 'customers' %}
    <i>/</i>
    {{ 'sections.breadcrumbs.my_account' | t }}
  {% endif %}
</nav>
