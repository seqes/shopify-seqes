{%- comment -%}
  Reviews Slideshow block for Product Information.
  Displays a rotating carousel of customer reviews with photo bubbles,
  star ratings, and a configurable verified badge (e.g. Google).

  Required: block (with settings below)
{%- endcomment -%}

{%- liquid
  assign bid = block.id
  assign speed = block.settings.autoplay_speed | default: 5
  assign badge_logo = block.settings.badge_logo
  assign badge_text = block.settings.badge_text
  assign star_color = block.settings.star_color | default: '#FAA525'
  assign bg = block.settings.bg_color | default: '#f5f0eb'
  assign text_col = block.settings.text_color | default: '#003b3d'
  assign photo_size = block.settings.photo_size | default: 48
-%}

{%- capture star_svg -%}<svg width="14" height="14" viewBox="0 0 20 20" fill="{{ star_color }}" xmlns="http://www.w3.org/2000/svg"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.69l5.34-.78L10 1z"/></svg>{%- endcapture -%}

{%- capture half_star_svg -%}<svg width="14" height="14" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="half-{{ bid }}"><stop offset="50%" stop-color="{{ star_color }}"/><stop offset="50%" stop-color="#d1d5db"/></linearGradient></defs><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.69l5.34-.78L10 1z" fill="url(#half-{{ bid }})"/></svg>{%- endcapture -%}

{%- capture empty_star_svg -%}<svg width="14" height="14" viewBox="0 0 20 20" fill="#d1d5db" xmlns="http://www.w3.org/2000/svg"><path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.51.91-5.32L2.27 6.69l5.34-.78L10 1z"/></svg>{%- endcapture -%}

{%- style -%}
  .rsb-{{ bid }} {
    background: {{ bg }};
    border-radius: 1rem;
    padding: 1.4rem 1.6rem;
    margin: 8px 0;
    position: relative;
    overflow: hidden;
    color: {{ text_col }};
  }
  .rsb-{{ bid }} .rsb-track {
    display: flex;
    transition: transform 0.45s cubic-bezier(0.4,0,0.2,1);
  }
  .rsb-{{ bid }} .rsb-slide {
    min-width: 100%;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .rsb-{{ bid }} .rsb-top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .rsb-{{ bid }} .rsb-photo {
    width: {{ photo_size }}px;
    height: {{ photo_size }}px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid rgba(0,0,0,0.06);
  }
  .rsb-{{ bid }} .rsb-photo-placeholder {
    width: {{ photo_size }}px;
    height: {{ photo_size }}px;
    border-radius: 50%;
    flex-shrink: 0;
    background: rgba(0,0,0,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ photo_size | divided_by: 2 }}px;
    color: rgba(0,0,0,0.3);
    line-height: 1;
  }
  .rsb-{{ bid }} .rsb-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .rsb-{{ bid }} .rsb-name {
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.2;
  }
  .rsb-{{ bid }} .rsb-stars {
    display: flex;
    gap: 1px;
    align-items: center;
  }
  .rsb-{{ bid }} .rsb-text {
    font-size: 1.35rem;
    line-height: 1.55;
    margin: 0;
    font-style: italic;
    opacity: 0.9;
  }
  .rsb-{{ bid }} .rsb-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.2rem;
    font-size: 1.1rem;
    opacity: 0.6;
  }
  .rsb-{{ bid }} .rsb-badge img {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }
  .rsb-{{ bid }} .rsb-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 0.6rem;
  }
  .rsb-{{ bid }} .rsb-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: {{ text_col }};
    opacity: 0.2;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .rsb-{{ bid }} .rsb-dot.active {
    opacity: 0.7;
  }
{%- endstyle -%}

{%- assign review_count = 0 -%}
{%- for i in (1..6) -%}
  {%- assign text_key = 'review_' | append: i | append: '_text' -%}
  {%- if block.settings[text_key] != blank -%}
    {%- assign review_count = review_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- if review_count > 0 -%}
<div class="rsb-{{ bid }}" {{ block.shopify_attributes }}>
  <div class="rsb-track" data-rsb-track>
    {%- for i in (1..6) -%}
      {%- liquid
        assign img_key = 'review_' | append: i | append: '_image'
        assign name_key = 'review_' | append: i | append: '_name'
        assign text_key = 'review_' | append: i | append: '_text'
        assign stars_key = 'review_' | append: i | append: '_stars'
        assign r_img = block.settings[img_key]
        assign r_name = block.settings[name_key]
        assign r_text = block.settings[text_key]
        assign r_stars = block.settings[stars_key] | times: 1
      -%}
      {%- if r_text != blank -%}
        <div class="rsb-slide">
          <div class="rsb-top">
            {%- if r_img != blank -%}
              <img class="rsb-photo" src="{{ r_img | image_url: width: 120 }}" alt="{{ r_name | escape }}" width="{{ photo_size }}" height="{{ photo_size }}" loading="lazy">
            {%- else -%}
              <div class="rsb-photo-placeholder">
                {%- if r_name != blank -%}{{ r_name | slice: 0 }}{%- else -%}?{%- endif -%}
              </div>
            {%- endif -%}
            <div class="rsb-meta">
              {%- if r_name != blank -%}
                <span class="rsb-name">{{ r_name }}</span>
              {%- endif -%}
              {%- if r_stars > 0 -%}
                <div class="rsb-stars">
                  {%- for s in (1..5) -%}
                    {%- if s <= r_stars -%}
                      {{ star_svg }}
                    {%- else -%}
                      {{ empty_star_svg }}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </div>
          <p class="rsb-text">"{{ r_text }}"</p>
          {%- if badge_logo != blank or badge_text != blank -%}
            <div class="rsb-badge">
              {%- if badge_logo != blank -%}
                <img src="{{ badge_logo | image_url: width: 48 }}" alt="{{ badge_text | escape }}" width="16" height="16">
              {%- endif -%}
              {%- if badge_text != blank -%}
                <span>{{ badge_text }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if review_count > 1 -%}
    <div class="rsb-dots" data-rsb-dots>
      {%- for i in (1..review_count) -%}
        <button class="rsb-dot{% if i == 1 %} active{% endif %}" data-rsb-goto="{{ i | minus: 1 }}" aria-label="Review {{ i }}"></button>
      {%- endfor -%}
    </div>

    <script>
      (function(){
        var root = document.querySelector('.rsb-{{ bid }}');
        if (!root) return;
        var track = root.querySelector('[data-rsb-track]');
        var dots = root.querySelectorAll('[data-rsb-goto]');
        var total = {{ review_count }};
        var current = 0;
        var speed = {{ speed }} * 1000;
        var timer;

        function goTo(idx) {
          current = ((idx % total) + total) % total;
          track.style.transform = 'translateX(-' + (current * 100) + '%)';
          dots.forEach(function(d, i) { d.classList.toggle('active', i === current); });
        }

        dots.forEach(function(d) {
          d.addEventListener('click', function() {
            goTo(parseInt(d.dataset.rsbGoto));
            clearInterval(timer);
            timer = setInterval(function(){ goTo(current + 1); }, speed);
          });
        });

        timer = setInterval(function(){ goTo(current + 1); }, speed);
      })();
    </script>
  {%- endif -%}
</div>
{%- endif -%}