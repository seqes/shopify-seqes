{%- liquid
  assign bullet_color = bullet_color | default: '#00393b'
  assign claim_font_size = font_size | default: 15
  assign animate = animate | default: true
-%}
{%- if claims != blank -%}
{%- assign claims_list = claims | split: '|' -%}
<style>
  .seqes-claims {
    margin: 14px 0;
  }
  .seqes-claims-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .seqes-claims-item {
    display: flex;
    align-items: center;
    font-size: {{ claim_font_size }}px;
    margin-bottom: 6px;
    font-weight: 500;
    line-height: 1.3;
  }
  .seqes-bullet {
    width: 8px;
    height: 8px;
    background: {{ bullet_color }};
    border-radius: 50%;
    margin-right: 10px;
    flex-shrink: 0;
    {%- if animate %}
    animation: seqesGlow 1.8s infinite ease-in-out;
    {%- endif %}
  }
  {%- if animate %}
  @keyframes seqesGlow {
    0% { box-shadow: 0 0 0 0 rgba({{ bullet_color | color_extract: 'red' }},{{ bullet_color | color_extract: 'green' }},{{ bullet_color | color_extract: 'blue' }},0.0); opacity: 1; }
    50% { box-shadow: 0 0 8px 2px rgba({{ bullet_color | color_extract: 'red' }},{{ bullet_color | color_extract: 'green' }},{{ bullet_color | color_extract: 'blue' }},0.35); opacity: 0.75; }
    100% { box-shadow: 0 0 0 0 rgba({{ bullet_color | color_extract: 'red' }},{{ bullet_color | color_extract: 'green' }},{{ bullet_color | color_extract: 'blue' }},0.0); opacity: 1; }
  }
  {%- endif %}
</style>
<div class="seqes-claims">
  <ul class="seqes-claims-list">
    {%- for claim in claims_list -%}
      {%- assign claim_text = claim | strip -%}
      {%- if claim_text != blank -%}
      <li class="seqes-claims-item">
        <span class="seqes-bullet"></span>
        {{ claim_text }}
      </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>
{%- endif -%}
