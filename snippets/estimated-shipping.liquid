{%- comment -%}
  Estimated shipping date block.
  Uses a lightweight custom element to calculate dates client-side.
  Required params: block (Shopify block object)
{%- endcomment -%}

<style>
  .est-shipping { display: flex; align-items: center; gap: 8px; margin: 4px 0; font-size: 0.9em; }
  .est-shipping__icon { flex-shrink: 0; display: flex; align-items: center; }
  .est-shipping__icon--small { font-size: 18px; }
  .est-shipping__icon--small img { height: 18px; width: auto; }
  .est-shipping__icon--medium { font-size: 24px; }
  .est-shipping__icon--medium img { height: 24px; width: auto; }
  .est-shipping__icon--large { font-size: 32px; }
  .est-shipping__icon--large img { height: 32px; width: auto; }
</style>

<div class="est-shipping" {{ block.shopify_attributes }}>
  {%- unless block.settings.custom_icon == blank and block.settings.icon == blank -%}
    <div class="est-shipping__icon est-shipping__icon--{{ block.settings.icon_size }}">
      {%- if block.settings.custom_icon != blank -%}
        <img src="{{ block.settings.custom_icon | image_url: width: 150 }}" loading="lazy" role="presentation">
      {%- else -%}
        {%- render 'material-icon', icon: block.settings.icon, filled: block.settings.filled_icon -%}
      {%- endif -%}
    </div>
  {%- endunless -%}
  <span
    class="est-shipping__text"
    data-est-shipping
    data-message="{{ block.settings.message | escape }}"
    data-min-days="{{ block.settings.min_shipping_days }}"
    data-max-days="{{ block.settings.max_shipping_days }}"
    data-date-format="{{ block.settings.date_format }}"
    data-locale="{{ request.locale.iso_code }}"
  >
    {{ block.settings.message | replace: '[start_date]', '...' | replace: '[end_date]', '...' }}
  </span>
</div>

<script>
  (function(){
    document.querySelectorAll('[data-est-shipping]').forEach(function(el){
      if (el.dataset.processed) return;
      el.dataset.processed = '1';
      var msg = el.dataset.message;
      var min = parseInt(el.dataset.minDays, 10);
      var max = parseInt(el.dataset.maxDays, 10);
      var fmt = el.dataset.dateFormat || 'short';
      var locale = el.dataset.locale || 'en';
      var now = new Date();
      var startDate = new Date(now);
      startDate.setDate(startDate.getDate() + min);
      var endDate = new Date(now);
      endDate.setDate(endDate.getDate() + max);
      var opts = fmt === 'long'
        ? { month: 'long', day: 'numeric' }
        : { month: 'short', day: 'numeric' };
      var startStr = startDate.toLocaleDateString(locale, opts);
      var endStr = endDate.toLocaleDateString(locale, opts);
      el.textContent = msg.replace('[start_date]', startStr).replace('[end_date]', endStr);
    });
  })();
</script>
