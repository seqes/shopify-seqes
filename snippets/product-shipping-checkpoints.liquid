{% liquid
  assign ordered_day = block.settings.ordered_day | default: 'Today'
  assign ordered_label = block.settings.ordered_label | default: 'Ordered'
  assign shipped_day = block.settings.shipped_day | default: 'Tomorrow'
  assign shipped_label = block.settings.shipped_label | default: 'Shipped'
  assign delivered_day = block.settings.delivered_day | default: '2–4 days'
  assign delivered_label = block.settings.delivered_label | default: 'Delivered'
  assign accent_color = block.settings.accent_color | default: '#00393b'
  assign muted_color = block.settings.muted_color | default: '#7d7d7d'
  assign line_color = block.settings.line_color | default: '#d9d9d9'
  assign background_color = block.settings.background_color | default: '#ffffff'
%}

<style>
  .seqes-shipping-checkpoints-{{ block.id }} {
    margin: 1.6rem 0 0;
    padding: 1.4rem 1.2rem;
    border-radius: 1.2rem;
    background: {{ background_color }};
    border: 1px solid rgba(0,0,0,.06);
  }

  .seqes-shipping-checkpoints__grid-{{ block.id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
    text-align: center;
    position: relative;
  }

  .seqes-shipping-checkpoints__grid-{{ block.id }}::before {
    content: "";
    position: absolute;
    left: 16.66%;
    right: 16.66%;
    top: 2.1rem;
    height: 1px;
    background: {{ line_color }};
    z-index: 0;
  }

  .seqes-shipping-checkpoints__item-{{ block.id }} {
    position: relative;
    z-index: 1;
  }

  .seqes-shipping-checkpoints__icon-wrap-{{ block.id }} {
    width: 4.2rem;
    height: 4.2rem;
    margin: 0 auto .7rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid {{ line_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .seqes-shipping-checkpoints__icon-{{ block.id }} {
    width: 1.8rem;
    height: 1.8rem;
    color: {{ accent_color }};
    display: block;
  }

  .seqes-shipping-checkpoints__day-{{ block.id }} {
    font-size: 1.2rem;
    line-height: 1.3;
    color: {{ muted_color }};
    margin-bottom: .25rem;
  }

  .seqes-shipping-checkpoints__label-{{ block.id }} {
    font-size: 1.45rem;
    line-height: 1.3;
    font-weight: 600;
    color: {{ accent_color }};
  }

  @media screen and (max-width: 749px) {
    .seqes-shipping-checkpoints-{{ block.id }} {
      padding: 1.2rem .8rem;
    }

    .seqes-shipping-checkpoints__grid-{{ block.id }} {
      gap: .4rem;
    }

    .seqes-shipping-checkpoints__grid-{{ block.id }}::before {
      left: 18%;
      right: 18%;
      top: 1.9rem;
    }

    .seqes-shipping-checkpoints__icon-wrap-{{ block.id }} {
      width: 3.6rem;
      height: 3.6rem;
      margin-bottom: .55rem;
    }

    .seqes-shipping-checkpoints__icon-{{ block.id }} {
      width: 1.5rem;
      height: 1.5rem;
    }

    .seqes-shipping-checkpoints__day-{{ block.id }} {
      font-size: 1.05rem;
    }

    .seqes-shipping-checkpoints__label-{{ block.id }} {
      font-size: 1.2rem;
    }
  }
</style>

<div class="seqes-shipping-checkpoints-{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="seqes-shipping-checkpoints__grid-{{ block.id }}">
    <div class="seqes-shipping-checkpoints__item-{{ block.id }}">
      <div class="seqes-shipping-checkpoints__icon-wrap-{{ block.id }}">
        <svg class="seqes-shipping-checkpoints__icon-{{ block.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 4V2M17 4V2M3 9H21M5 5H19C20.1046 5 21 5.89543 21 7V19C21 20.1046 20.1046 21 19 21H5C3.89543 21 3 20.1046 3 19V7C3 5.89543 3.89543 5 5 5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="seqes-shipping-checkpoints__day-{{ block.id }}">{{ ordered_day }}</div>
      <div class="seqes-shipping-checkpoints__label-{{ block.id }}">{{ ordered_label }}</div>
    </div>

    <div class="seqes-shipping-checkpoints__item-{{ block.id }}">
      <div class="seqes-shipping-checkpoints__icon-wrap-{{ block.id }}">
        <svg class="seqes-shipping-checkpoints__icon-{{ block.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3 7H15V15H3V7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M15 10H18.5L21 12.5V15H15V10Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <circle cx="7.5" cy="17.5" r="1.5" stroke="currentColor" stroke-width="1.8"/>
          <circle cx="17.5" cy="17.5" r="1.5" stroke="currentColor" stroke-width="1.8"/>
        </svg>
      </div>
      <div class="seqes-shipping-checkpoints__day-{{ block.id }}">{{ shipped_day }}</div>
      <div class="seqes-shipping-checkpoints__label-{{ block.id }}">{{ shipped_label }}</div>
    </div>

    <div class="seqes-shipping-checkpoints__item-{{ block.id }}">
      <div class="seqes-shipping-checkpoints__icon-wrap-{{ block.id }}">
        <svg class="seqes-shipping-checkpoints__icon-{{ block.id }}" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 3L19 7V12C19 16.5 16.2 20 12 21C7.8 20 5 16.5 5 12V7L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="seqes-shipping-checkpoints__day-{{ block.id }}">{{ delivered_day }}</div>
      <div class="seqes-shipping-checkpoints__label-{{ block.id }}">{{ delivered_label }}</div>
    </div>
  </div>
</div>