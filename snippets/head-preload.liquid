<link rel="preload" as="style" href="{{ 'app.css' | asset_url }}">
{%- comment -%}
  Preload only the two Gilroy weights actually used for first paint:
  Regular (400) for body copy and Bold (700) for headings. The other
  weights (Light, Medium, italics) are declared in @font-face but not
  preloaded, so they load on demand when visible text actually uses them.
  Only emit these preloads when the theme is configured to use Gilroy.
{%- endcomment -%}
{%- if settings.custom_body_font_choice == 'gilroy' -%}
<link rel="preload" as="font" type="font/woff2" href="{{ 'Gilroy-Regular.woff2' | asset_url }}" crossorigin>
{%- endif -%}
{%- if settings.custom_heading_font_choice == 'gilroy' -%}
<link rel="preload" as="font" type="font/woff2" href="{{ 'Gilroy-Bold.woff2' | asset_url }}" crossorigin>
{%- endif -%}
{% if template contains 'product' -%}
<link rel="preload" as="style" href="{{ 'product.css' | asset_url }}">
{% liquid
	if product.selected_or_first_available_variant.featured_media.preview_image
		assign product_image = product.selected_or_first_available_variant.featured_media.preview_image
	elsif product.featured_media
		assign product_image = product.featured_media.preview_image
	endif
	if product_image
		render 'responsive-preload', image: product_image, sizes: '375x0,640x0,960x0'
	endif
%}
{%- endif %}
{% if template contains 'collection' -%}
{% liquid
	if collection.featured_image
		assign image = collection.featured_image
		assign master_width = image.src.width | append: 'x' | append: image.src.height
		assign sizes = '0x350,0x700,' | append: master_width
		render 'responsive-preload', image: image, sizes: sizes
	endif
-%}
{%- endif %}
{% if settings.animations %}
{{ 'animations.min.js' | asset_url | preload_tag: as: 'script' }}
{% endif %}
{{ 'header.js' | asset_url | preload_tag: as: 'script' }}
{{ 'vendor.min.js' | asset_url | preload_tag: as: 'script' }}
{{ 'app.js' | asset_url | preload_tag: as: 'script' }}
{%- comment -%}
  slideshow.js is no longer preloaded globally. It is preloaded/loaded only
  on templates that actually contain a slideshow-type section to avoid
  wasted network priority on pages like cart, account, or product where
  no slideshow is rendered.
{%- endcomment -%}
{%- if template == 'index' or template == 'product' or template contains 'page' -%}
  {{ 'slideshow.js' | asset_url | preload_tag: as: 'script' }}
{%- endif -%}

<script>
window.lazySizesConfig = window.lazySizesConfig || {};
window.lazySizesConfig.expand = 250;
window.lazySizesConfig.loadMode = 1;
window.lazySizesConfig.loadHidden = false;
</script>
