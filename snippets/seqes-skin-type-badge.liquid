{%- liquid
  assign badge_text = text | default: ''
  assign badge_color = color | default: '#FAA525'
  assign badge_font_size = font_size | default: 17
-%}
{%- if badge_text != blank -%}
<style>
  .seqes-skin-text {
    margin: 16px 0;
    text-align: left;
    color: {{ badge_color }};
    font-size: {{ badge_font_size }}px;
    line-height: 1.4;
    font-weight: 500;
  }
</style>
<div class="seqes-skin-text">
  {{ badge_text }}
</div>
{%- endif -%}
