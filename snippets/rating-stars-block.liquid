{%- comment -%}
  Star rating display block.
  Uses CSS clip-path for fractional star support.
  Required params: block (Shopify block object)
{%- endcomment -%}

{%- assign star_pct = block.settings.rating | times: 20.0 -%}
<div
  class="rating-stars-block"
  style="--star-pct:{{ star_pct }}%;--star-color:{{ block.settings.star_color }};--bg-star-color:{{ block.settings.bg_star_color }};--star-size:{{ block.settings.size }}px;display:flex;align-items:center;gap:4px;justify-content:{{ block.settings.alignment }};margin:4px 0;"
  {{ block.shopify_attributes }}
>
  <div style="position:relative;display:inline-flex;gap:2px">
    <div style="display:flex;gap:2px;color:var(--bg-star-color)">
      {%- for i in (1..5) -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" fill="currentColor" style="width:var(--star-size);height:var(--star-size)">
          <path d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z"/>
        </svg>
      {%- endfor -%}
    </div>
    <div style="position:absolute;top:0;left:0;display:flex;gap:2px;color:var(--star-color);clip-path:inset(0 calc(100% - var(--star-pct)) 0 0);overflow:hidden">
      {%- for i in (1..5) -%}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" fill="currentColor" style="width:var(--star-size);height:var(--star-size)">
          <path d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z"/>
        </svg>
      {%- endfor -%}
    </div>
  </div>
  {%- if block.settings.label != blank -%}
    <span style="font-size:{{ block.settings.size | times: 0.6 }}px">{{ block.settings.label }}</span>
  {%- endif -%}
</div>
