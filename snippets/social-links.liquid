{%- comment -%}
  Redes sociales de la tienda. Se leen de Configuracion > Marca (shop.brand), el unico lugar donde se editan.
{%- endcomment -%}
{%- assign redes = 'facebook,instagram,tiktok,threads,youtube,twitter,pinterest,linkedin,snapchat,vimeo' | split: ',' -%}
<ul class="social-links">
	{%- for red in redes -%}
		{%- assign enlace = shop.brand.metafields.social_links[red].value -%}
		{%- if enlace != blank -%}
			{%- assign etiqueta = 'social.links.' | append: red | t -%}
			<li><a href="{{ enlace }}" class="social {{ red }}" target="_blank" rel="noreferrer" title="{{ etiqueta }}">{% render 'svg-icons' with red %} <span>{{ etiqueta }}</span></a></li>
		{%- endif -%}
	{%- endfor -%}
</ul>
